      "fontFamily": 1,
      "text": "Key difference: RabbitMQ broker never emits a trace (passive); the EMQX broker DOES (native OTel -> DDOT).",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Key difference: RabbitMQ broker never emits a trace (passive); the EMQX broker DOES (native OTel -> DDOT).",
